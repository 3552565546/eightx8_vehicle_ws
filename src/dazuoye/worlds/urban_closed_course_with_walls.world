    <!-- 城市道路系统 - 十字交叉路 -->
    <!-- 南北主干道 -->
    <model name="north_south_road">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8 40 0.04</size>
            </box>
          </geometry>
        </collision>
