<?xml version="1.0" encoding="utf-8"?>
<robot name="my_sensors" xmlns:xacro="http://wiki.ros.org/xacro">
  
  <!-- 定义摄像头宏 -->
  <xacro:macro name="camera_sensor" params="camera_name">
    <gazebo reference="${camera_name}">
      <!-- 类型设置为 camera -->
      <sensor type="camera" name="${camera_name}_node">
        <update_rate>30.0</update_rate> <!-- 更新频率 -->
        <!-- 摄像头基本信息设置 -->
        <camera name="head">
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <!-- 核心插件 -->
        <plugin name="gazebo_camera_${camera_name}" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>${camera_name}</cameraName> <!-- 为发布话题设置命名空间 -->
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>${camera_name}</frameName> <!-- 连杆名称 -->
          <hackBaseline>0.07</hackBaseline>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
  
  <!-- 调用宏创建6个摄像头 -->
  <xacro:camera_sensor camera_name="camera1"/>
  <xacro:camera_sensor camera_name="camera2"/>
  <xacro:camera_sensor camera_name="camera3"/>
  <xacro:camera_sensor camera_name="camera4"/>
  <xacro:camera_sensor camera_name="camera5"/>
  <xacro:camera_sensor camera_name="camera6"/>
  
</robot>
