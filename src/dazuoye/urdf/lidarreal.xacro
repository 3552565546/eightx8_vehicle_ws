<!-- 雷达配置 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <gazebo reference="leida">
    <sensor type="ray" name="rplidar">
      <!-- 位姿：相对于laser_link坐标系 -->
      <pose>0 0 0 0 0 0</pose>
      
      <!-- 可视化：在Gazebo中显示激光射线 -->
      <visualize>true</visualize>
      
      <!-- 更新频率：10Hz -->
      <update_rate>10</update_rate>
      
      <ray>
        <scan>
          <horizontal>
            <!-- 360条射线，每度一条 -->
            <samples>360</samples>
            <resolution>1</resolution>
            <!-- -180° 到 +180° 全方位扫描 -->
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        
        <range>
          <!-- 探测范围：0.1米 到 30米 -->
          <min>0.10</min>
          <max>30.0</max>
          <!-- 距离分辨率：1厘米 -->
          <resolution>0.01</resolution>
        </range>
        
        <!-- 高斯噪声，模拟真实传感器误差 -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      
      <!-- Gazebo ROS 激光雷达插件 -->
      <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_laser.so">
        <!-- 发布到 /scan 话题 -->
        <topicName>/scan</topicName>
        <!-- 使用 laser_link 坐标系 -->
        <frameName>leida</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
