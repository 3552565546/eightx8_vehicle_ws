<?xml version="1.0" encoding="utf-8"?>
<robot name="dazuoye_control" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 车辆参数 -->
  <xacro:property name="wheel_separation" value="0.28528" />
  <xacro:property name="wheel_radius" value="0.07395" />

  <!-- 为所有8个轮子添加传动 -->
  <xacro:macro name="joint_trans" params="joint_name">
    <transmission name="${joint_name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint_name}">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint_name}_motor">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:joint_trans joint_name="basewheel1" />
  <xacro:joint_trans joint_name="basewheel2" />
  <xacro:joint_trans joint_name="basewheel3" />
  <xacro:joint_trans joint_name="basewheel4" />
  <xacro:joint_trans joint_name="basewheel5" />
  <xacro:joint_trans joint_name="basewheel6" />
  <xacro:joint_trans joint_name="basewheel7" />
  <xacro:joint_trans joint_name="basewheel8" />

  <!-- 使用skid-steer驱动插件 -->
  <gazebo>
    <plugin name="skid_steer_drive_controller" filename="libgazebo_ros_skid_steer_drive.so">
      <updateRate>100.0</updateRate>
      <robotNamespace>/</robotNamespace>
      
      <!-- 左侧所有轮子 -->
      <leftFrontJoint>basewheel1</leftFrontJoint>
      <leftRearJoint>basewheel2</leftRearJoint>
      <leftFrontJoint>basewheel3</leftFrontJoint>
      <leftRearJoint>basewheel4</leftRearJoint>
      
      <!-- 右侧所有轮子 -->
      <rightFrontJoint>basewheel5</rightFrontJoint>
      <rightRearJoint>basewheel6</rightRearJoint>
      <rightFrontJoint>basewheel7</rightFrontJoint>
      <rightRearJoint>basewheel8</rightRearJoint>
      
      <wheelSeparation>0.28528</wheelSeparation>
      <wheelDiameter>0.1479</wheelDiameter>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <torque>50</torque>
      <topicName>cmd_vel</topicName>
      <broadcastTF>1</broadcastTF>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
    </plugin>
  </gazebo>

</robot>
